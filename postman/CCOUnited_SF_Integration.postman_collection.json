{
  "info": {
    "name": "CCO United \u2014 Salesforce Integration",
    "description": "API contract tests for the Monday.com \u2192 Salesforce ETL integration powering CCO United. Covers Event__c (custom object), Account (CCO Registry), Case (Housing Inquiry), and Lead (Subscriber) objects via the Salesforce REST API.\n\nAuth: OAuth 2.0 username+password flow. Set credentials in the matching environment file. The pre-request script in each folder automatically fetches and caches the access token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ccou-sf-integration-v1"
  },
  "variable": [],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{sf_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Skip auth refresh if token is still valid (cached within this run)",
          "if (pm.collectionVariables.get('sf_access_token')) return;",
          "",
          "const tokenUrl = pm.environment.get('sf_login_url') + '/services/oauth2/token';",
          "pm.sendRequest({",
          "  url: tokenUrl,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "  body: {",
          "    mode: 'urlencoded',",
          "    urlencoded: [",
          "      { key: 'grant_type',    value: 'password' },",
          "      { key: 'client_id',     value: pm.environment.get('sf_client_id') },",
          "      { key: 'client_secret', value: pm.environment.get('sf_client_secret') },",
          "      { key: 'username',      value: pm.environment.get('sf_username') },",
          "      { key: 'password',      value: pm.environment.get('sf_password') + pm.environment.get('sf_security_token') }",
          "    ]",
          "  }",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) {",
          "    console.error('SF auth failed:', err || res.json());",
          "    return;",
          "  }",
          "  const body = res.json();",
          "  pm.collectionVariables.set('sf_access_token', body.access_token);",
          "  pm.environment.set('sf_instance_url', body.instance_url);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Event__c \u2014 CCO Events Calendar",
      "description": "CRUD operations on the Event__c custom object. Records are ETL-synced from the Monday.com CN Master Events Calendar board (ID: 18415647485).",
      "item": [
        {
          "name": "GET \u2014 Upcoming Public Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sf_instance_url}}/services/data/v61.0/query?q=SELECT Id,Name,Event_Date__c,Location__c,Event_Type__c,Description__c,Status__c FROM Event__c WHERE Is_Public__c=true AND Status__c='Approved' AND Event_Date__c>=TODAY ORDER BY Event_Date__c ASC LIMIT 20",
              "host": [
                "{{sf_instance_url}}"
              ],
              "path": [
                "services",
                "data",
                "v61.0",
                "query"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "SELECT Id,Name,Event_Date__c,Location__c,Event_Type__c,Description__c,Status__c FROM Event__c WHERE Is_Public__c=true AND Status__c='Approved' AND Event_Date__c>=TODAY ORDER BY Event_Date__c ASC LIMIT 20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns records array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('records');",
                  "  pm.expect(body.records).to.be.an('array');",
                  "});",
                  "pm.test('Each event has required fields', () => {",
                  "  const records = pm.response.json().records;",
                  "  records.forEach(r => {",
                  "    pm.expect(r).to.have.property('Name');",
                  "    pm.expect(r).to.have.property('Event_Date__c');",
                  "    pm.expect(r).to.have.property('Status__c').that.equals('Approved');",
                  "  });",
                  "});",
                  "// Cache first event ID for downstream requests",
                  "const records = pm.response.json().records;",
                  "if (records.length > 0) pm.collectionVariables.set('event_id', records[0].Id);"
                ]
              }
            }
          ],
          "response": []
        },
